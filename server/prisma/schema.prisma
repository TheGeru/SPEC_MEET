generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String        @id @default(uuid())
  email               String        @unique
  password            String
  name                String
  role                String        @default("CLIENT")
  createdAt           DateTime      @default(now())
  resetPasswordToken  String?       @unique
  updatedAt           DateTime      @updatedAt
  resetPasswordExpire DateTime?
  reservations        Reservation[]
}

model Room {
  id             String         @id @default(uuid())
  name           String
  wifi_ssid      String
  wifi_pass      String
  createdAt      DateTime       @default(now())
  status         String         @default("INACTIVO")
  updatedAt      DateTime       @updatedAt
  capacity       Int            @default(10)
  ttlock_lock_id String?
  amenities      Json           @default("[]")
  locationId     Int            @map("location_id")
  blockedSlots   BlockedSlot[]
  reservations   Reservation[]
  location       BusinessConfig @relation(fields: [locationId], references: [id])
  packages       PricePackage[]
  baseRates      RoomBaseRate[]
}

model Reservation {
  id             String       @id @default(uuid())
  userId         String
  roomId         String
  start_time     DateTime
  end_time       DateTime
  access_code    String?
  total_paid     Decimal
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
  terms_accepted Boolean      @default(false)
  packageId      String?       @map("package_id")
  termsVersion   String       @map("terms_version")
  payment        Payment?
  package        PricePackage? @relation(fields: [packageId], references: [id])
  room           Room         @relation(fields: [roomId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([roomId, start_time, end_time])
}

model BlockedSlot {
  id         String   @id @default(uuid())
  roomId     String
  start_time DateTime
  end_time   DateTime
  reason     String?
  createdAt  DateTime @default(now())
  room       Room     @relation(fields: [roomId], references: [id])

  @@index([roomId, start_time, end_time])
}

model Payment {
  id            String      @id @default(uuid())
  reservationId String      @unique
  amount        Decimal
  provider_id   String
  status        String
  iva_breakdown String?
  createdAt     DateTime    @default(now())
  currency      String      @default("MXN")
  paymentMethod String?
  reservation   Reservation @relation(fields: [reservationId], references: [id])
}

model PricePackage {
  id           String        @id @default(uuid())
  name         String
  description  String?
  billingUnit  BillingUnit   @map("billing_unit")
  minDuration  Int?          @map("min_duration")
  maxDuration  Int?          @map("max_duration")
  metadata     Json          @default("{}")
  roomId       String?       @map("room_id")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  reservations Reservation[]
  room         Room?         @relation(fields: [roomId], references: [id])

  @@index([roomId])
  @@index([billingUnit])
  @@map("price_packages")
}

model RoomBaseRate {
  id             String    @id @default(uuid())
  roomId         String    @map("room_id")
  hourlyRate     Decimal   @map("hourly_rate") @db.Decimal(10, 2)
  currency       String    @default("MXN") @db.Char(3)
  effectiveFrom  DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveUntil DateTime? @map("effective_until") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  room           Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, effectiveFrom(sort: Desc)])
  @@map("room_base_rates")
}

model BusinessConfig {
  id                 Int      @id @default(1)
  locationName       String   @default("SPEC.MEET Central")
  address            String
  accessInstructions String?
  openingHours       Json
  refundFullHours    Int      @default(24)
  refundPartialHours Int      @default(12)
  refundPartialPct   Int      @default(50)
  updatedAt          DateTime @updatedAt
  rooms              Room[]
}

model TermsConfig {
  id                String   @id @default(uuid())
  version           String
  isActive          Boolean  @default(false)
  templateContent   String
  additionalClauses String?
  privacyOptions    Json
  createdAt         DateTime @default(now())

  @@map("terms_and_conditions")
}

enum BillingUnit {
  hour
  half_day
  full_day
  flat
  custom
}
