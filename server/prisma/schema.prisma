generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// MODELOS DE USUARIO Y AUTENTICACIÓN
// ---------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("CLIENT") // Ojo: Si usas un Enum, cámbialo aquí
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Recuperación de contraseña
  resetPasswordToken   String?   @unique
  resetPasswordExpire DateTime? // Corregido a 'Expires' para coincidir con el controlador

  // Relaciones
  reservations Reservation[]
}

// ---------------------------------------------------------
// MODELOS DE SALAS Y RESERVAS
// ---------------------------------------------------------

model Room {
  id             String   @id @default(uuid())
  name           String
  wifi_ssid      String
  wifi_pass      String
  capacity       Int      @default(10)
  status         String   @default("INACTIVO")
  ttlock_lock_id String?
  amenities      Json     @default("[]")        // ["wifi", "hdmi", "ac", "privacidad", "acceso_autonomo"]
  locationId     Int      @map("location_id")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relaciones
  location     BusinessConfig @relation(fields: [locationId], references: [id])
  reservations Reservation[]
  blockedSlots BlockedSlot[] // 👈 NUEVO: Relación inversa para los mantenimientos
  packages     PricePackage[]
  baseRates    RoomBaseRate[]
  
}

model Reservation {
  id                     String   @id @default(uuid())
  userId                 String
  roomId                 String
  packageId              String   @map("package_id")
  start_time             DateTime
  end_time               DateTime
  access_code            String?
  total_paid             Decimal
  status                 String   @default("PENDING")
  terms_accepted         Boolean  @default(false)
  termsVersion           String   @map("terms_version")
  createdAt              DateTime @default(now())

  // Relaciones
 payment Payment?
  room    Room         @relation(fields: [roomId], references: [id])
  user    User         @relation(fields: [userId], references: [id])
  package PricePackage @relation(fields: [packageId], references: [id])

  // Índices para búsquedas rápidas de disponibilidad
  @@index([roomId, start_time, end_time])
}

// 👇 NUEVO MODELO: Para bloquear salas por mantenimiento o administración
model BlockedSlot {
  id         String   @id @default(uuid())
  roomId     String
  start_time DateTime
  end_time   DateTime
  reason     String? // Ej: "Limpieza", "Reparación", "Evento Privado"
  createdAt  DateTime @default(now())

  // Relaciones
  room Room @relation(fields: [roomId], references: [id])

  // Índice para búsqueda rápida
  @@index([roomId, start_time, end_time])
}

// ---------------------------------------------------------
// MODELOS DE PAGOS Y FINANZAS
// ---------------------------------------------------------

model Payment {
  id            String   @id @default(uuid())
  reservationId String   @unique
  amount        Decimal
  currency      String   @default("MXN")
  provider_id   String // Stripe Payment Intent ID
  status        String // succeeded, pending, failed
  paymentMethod String?
  iva_breakdown String? // Guardamos el JSON del desglose como String
  createdAt     DateTime @default(now())

  // Relaciones
  reservation Reservation @relation(fields: [reservationId], references: [id])
}

enum BillingUnit {
  hour
  half_day
  full_day
  flat
  custom
}

model PricePackage {
  id          String      @id @default(uuid())
  name        String
  description String?                              // nullable: some packages are self-explanatory
  billingUnit BillingUnit @map("billing_unit")
  minDuration Int?        @map("min_duration")     // nullable: not applicable for 'custom' type
  maxDuration Int?        @map("max_duration")     // nullable: not applicable for 'custom' type
  metadata    Json        @default("{}")            // { discountPct, blockHours, schedule, addOns... }
  roomId      String?     @map("room_id")          // nullable: NULL = applies to ALL rooms
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")

  room         Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  reservations Reservation[]

  @@index([roomId])
  @@index([billingUnit])
  @@map("price_packages")
}

model RoomBaseRate {
  id             String    @id @default(uuid())
  roomId         String    @map("room_id")
  hourlyRate     Decimal   @map("hourly_rate") @db.Decimal(10, 2)
  currency       String    @default("MXN") @db.Char(3)
  effectiveFrom  DateTime  @default(now()) @map("effective_from") @db.Timestamptz
  effectiveUntil DateTime? @map("effective_until") @db.Timestamptz  // nullable: NULL = currently active rate
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, effectiveFrom(sort: Desc)])
  @@map("room_base_rates")
}

// ---------------------------------------------------------
// MODELOS DE CONFIGURACIÓN DEL SISTEMA
// ---------------------------------------------------------

model BusinessConfig {
  id                 Int      @id @default(1)
  locationName       String   @default("SPEC.MEET Central")
  address            String
  accessInstructions String?   // nullable: some locations are straightforward
  openingHours       Json      // { "mon": { "open": "08:00", "close": "22:00" }, ... }
  refundFullHours    Int      @default(24)
  refundPartialHours Int      @default(12)
  refundPartialPct   Int      @default(50)
  updatedAt          DateTime @updatedAt

  rooms Room[]
}

model TermsConfig {
  id                String   @id @default(uuid())
  version           String
  isActive          Boolean  @default(false)
  templateContent   String   @db.Text // @db.Text permite textos muy largos
  additionalClauses String?
  privacyOptions    Json
  createdAt         DateTime @default(now())

  @@map("terms_and_conditions")
}
