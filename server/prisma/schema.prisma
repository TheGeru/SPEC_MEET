generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// MODELOS DE USUARIO Y AUTENTICACIÓN
// ---------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("CLIENT") // Ojo: Si usas un Enum, cámbialo aquí
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Recuperación de contraseña
  resetPasswordToken   String?   @unique
  resetPasswordExpire DateTime? // Corregido a 'Expires' para coincidir con el controlador

  // Relaciones
  reservations Reservation[]
}

// ---------------------------------------------------------
// MODELOS DE SALAS Y RESERVAS
// ---------------------------------------------------------

model Room {
  id             String   @id @default(uuid())
  name           String
  wifi_ssid      String
  wifi_pass      String
  price_per_hour Decimal
  capacity       Int      @default(10)
  status         String   @default("INACTIVO")
  ttlock_lock_id String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relaciones
  reservations Reservation[]
  blockedSlots BlockedSlot[] // 👈 NUEVO: Relación inversa para los mantenimientos
}

model Reservation {
  id                     String   @id @default(uuid())
  userId                 String
  roomId                 String
  start_time             DateTime
  end_time               DateTime
  access_code            String?
  total_paid             Decimal
  status                 String   @default("PENDING")
  terms_accepted         Boolean  @default(false)
  accepted_terms_version String?
  createdAt              DateTime @default(now())

  // Relaciones
  payment Payment?
  room    Room     @relation(fields: [roomId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  // Índices para búsquedas rápidas de disponibilidad
  @@index([roomId, start_time, end_time])
}

// 👇 NUEVO MODELO: Para bloquear salas por mantenimiento o administración
model BlockedSlot {
  id         String   @id @default(uuid())
  roomId     String
  start_time DateTime
  end_time   DateTime
  reason     String? // Ej: "Limpieza", "Reparación", "Evento Privado"
  createdAt  DateTime @default(now())

  // Relaciones
  room Room @relation(fields: [roomId], references: [id])

  // Índice para búsqueda rápida
  @@index([roomId, start_time, end_time])
}

// ---------------------------------------------------------
// MODELOS DE PAGOS Y FINANZAS
// ---------------------------------------------------------

model Payment {
  id            String   @id @default(uuid())
  reservationId String   @unique
  amount        Decimal
  currency      String   @default("MXN")
  provider_id   String // Stripe Payment Intent ID
  status        String // succeeded, pending, failed
  paymentMethod String?
  iva_breakdown String? // Guardamos el JSON del desglose como String
  createdAt     DateTime @default(now())

  // Relaciones
  reservation Reservation @relation(fields: [reservationId], references: [id])
}

model PricingPackage {
  id        Int      @id @default(autoincrement())
  name      String
  hours     Int
  price     Decimal
  discount  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// MODELOS DE CONFIGURACIÓN DEL SISTEMA
// ---------------------------------------------------------

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  dataType    String   @default("TEXT")
  updatedAt   DateTime @updatedAt
}

model BusinessConfig {
  id                 Int      @id @default(1)
  locationName       String   @default("SPEC.MEET Central")
  address            String
  accessInstructions String?
  openingHours       Json // { "mon": { "open": "09:00", "close": "18:00" }, ... }
  refundFullHours    Int      @default(24)
  refundPartialHours Int      @default(12)
  refundPartialPct   Int      @default(50)
  updatedAt          DateTime @updatedAt
}

model TermsConfig {
  id                String   @id @default(uuid())
  version           String
  isActive          Boolean  @default(false)
  templateContent   String   @db.Text // @db.Text permite textos muy largos
  additionalClauses String?
  privacyOptions    Json
  createdAt         DateTime @default(now())
  createdBy         String?
}

model TermsHistory {
  id          String    @id @default(uuid())
  version     String
  content     String    @db.Text
  activeFrom  DateTime  @default(now())
  activeUntil DateTime?
  createdAt   DateTime  @default(now())
}